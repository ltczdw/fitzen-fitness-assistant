# Backend configuration; copy to backend/.env and fill required values.
# Generated from Settings defaults, never from the live .env.
# List fields use JSON arrays; blank credentials disable optional providers.

# app env; see app/core/config.py for type and validation.
APP_ENV=development

# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# backend host; see app/core/config.py for type and validation.
BACKEND_HOST=127.0.0.1

# backend port; see app/core/config.py for type and validation.
BACKEND_PORT=8001

# mcp host; see app/core/config.py for type and validation.
MCP_HOST=127.0.0.1

# mcp port; see app/core/config.py for type and validation.
MCP_PORT=9000

# Required: PostgreSQL + psycopg URL; supply your own local credentials; pgvector extension required.
DATABASE_URL=

# OpenAI-compatible chat endpoint base URL; leave blank for deterministic fallback.
LLM_BASE_URL=

# Secret; fill locally only. Never commit backend/.env.
LLM_API_KEY=

# Chat/planning model available at your provider.
LLM_MODEL=

# llm timeout seconds; see app/core/config.py for type and validation.
LLM_TIMEOUT_SECONDS=60.0

# llm stream timeout seconds; see app/core/config.py for type and validation.
LLM_STREAM_TIMEOUT_SECONDS=30.0

# llm retry delays; see app/core/config.py for type and validation.
LLM_RETRY_DELAYS=2,4,10

# Per-process/upstream max simultaneous logical calls.
LLM_MAX_CONCURRENCY=4

# Per-process/upstream token refill rate.
LLM_REQUESTS_PER_SECOND=2.0

# Maximum token bucket burst.
LLM_RATE_BURST=4

# Total gateway-call budget, including queue, retry waits and tool loop.
LLM_TOTAL_DEADLINE_SECONDS=90.0

# llm circuit failure threshold; see app/core/config.py for type and validation.
LLM_CIRCUIT_FAILURE_THRESHOLD=3

# llm circuit recovery seconds; see app/core/config.py for type and validation.
LLM_CIRCUIT_RECOVERY_SECONDS=30.0

# Non-secret project limits also live in runtime-settings.json (above .env).
# Explicit process environment variables take precedence over that file.
LLM_CONTEXT_WINDOW_TOKENS=65536

# llm max output tokens; see app/core/config.py for type and validation.
LLM_MAX_OUTPUT_TOKENS=4096

# context safety margin; see app/core/config.py for type and validation.
CONTEXT_SAFETY_MARGIN=0.15

# context tokenizer path; see app/core/config.py for type and validation.
CONTEXT_TOKENIZER_PATH=

# Optional remote MCP endpoint; unavailable before dispatch falls back to local tools.
MCP_URL=http://127.0.0.1:9000/mcp

# mcp timeout seconds; see app/core/config.py for type and validation.
MCP_TIMEOUT_SECONDS=8.0

# embedding model; see app/core/config.py for type and validation.
EMBEDDING_MODEL=qwen3.7-text-embedding

# Embedding API base URL; reranker derives DashScope-style path from the same host.
RETRIEVAL_EMBEDDING_BASE_URL=

# Optional embedding/rerank credential; unset => lexical/rule fallback.
RETRIEVAL_EMBEDDING_API_KEY=

# retrieval embedding model; see app/core/config.py for type and validation.
# Verified against the locally configured provider on 2026-09-27; other providers may use different names.
RETRIEVAL_EMBEDDING_MODEL=qwen3.7-text-embedding

# retrieval embedding dimensions; see app/core/config.py for type and validation.
RETRIEVAL_EMBEDDING_DIMENSIONS=1024

# retrieval embedding index version; see app/core/config.py for type and validation.
RETRIEVAL_EMBEDDING_INDEX_VERSION=qwen37_1024_v1

# retrieval embedding timeout seconds; see app/core/config.py for type and validation.
RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=12.0

# retrieval vector threshold; see app/core/config.py for type and validation.
RETRIEVAL_VECTOR_THRESHOLD=0.5

# Per-process blocking retrieval workers; restart after changing.
RETRIEVAL_MAX_WORKERS=4
# Initial RAG evidence gate threshold; tune it against a labeled fitness QA set.
RAG_ANSWER_CONFIDENCE_THRESHOLD=0.48

# memory read backend; see app/core/config.py for type and validation.
MEMORY_READ_BACKEND=compact_v1

# memory short window turns; see app/core/config.py for type and validation.
MEMORY_SHORT_WINDOW_TURNS=10
MEMORY_RECENT_MAX_TOKENS=12000

# memory turn soft tokens; see app/core/config.py for type and validation.
MEMORY_TURN_SOFT_TOKENS=1200

# memory outbox interval seconds; see app/core/config.py for type and validation.
MEMORY_OUTBOX_INTERVAL_SECONDS=5.0

# Legacy setting retained; current chat entry uses planner LLM then rule fallback.
INTENT_ROUTER=planner_llm

# rag query rewrite enabled; see app/core/config.py for type and validation.
RAG_QUERY_REWRITE_ENABLED=false

# rerank model; see app/core/config.py for type and validation.
# Verified on the configured provider; requires the DashScope-style rerank endpoint supported by this client.
RERANK_MODEL=qwen3.7-text-rerank

# rerank enabled; see app/core/config.py for type and validation.
RERANK_ENABLED=true

# Independent rerank protocol/base/key. jina_cohere base includes /v1 or /v2.
RERANK_PROVIDER=dashscope
RERANK_BASE_URL=
RERANK_API_KEY=
# Compatibility only when both independent fields are empty and provider is dashscope.
RERANK_LEGACY_EMBEDDING_CONFIG=true

# rerank timeout seconds; see app/core/config.py for type and validation.
RERANK_TIMEOUT_SECONDS=15.0

# rerank min score; see app/core/config.py for type and validation.
RERANK_MIN_SCORE=0.1

# wiki enabled; see app/core/config.py for type and validation.
WIKI_ENABLED=true

# Wiki chat: remaining input capacity assigned to selected original memory.
WIKI_MEMORY_CONTEXT_FRACTION=0.60
# A bounded metadata batch; these do not cap total selected chapters.
WIKI_CATALOG_MAX_TOKENS=3000
WIKI_CATALOG_BATCH_SIZE=32
# Addressing steps share the request model budget and deadline.
WIKI_MEMORY_MAX_ROUNDS=3
# One bounded structured extraction over selected originals; failure keeps the
# complete original page. The input cap is a per-request byte/token bound.
WIKI_SEMANTIC_UNITS_ENABLED=true
WIKI_SEMANTIC_UNIT_MAX_CALLS=2
WIKI_SEMANTIC_UNIT_MAX_PAGES=8
WIKI_SEMANTIC_UNIT_MAX_INPUT_TOKENS=16000
# Independent source-read budget for bounded extraction; not the final answer budget.
WIKI_SOURCE_READ_MAX_TOKENS=14000
# Optional unit ablation: density (value / full incremental closure cost) or value.
WIKI_UNIT_RANKING=density
# Gentle bounded decay for source-bound model time-sensitive units only. Stable
# facts, explicit history views and required units are never age-penalized.
WIKI_TEMPORAL_DECAY_ENABLED=true
WIKI_TEMPORAL_HALF_LIFE_DAYS=30
WIKI_TEMPORAL_DECAY_FLOOR=0.85
# Business validity of conversation-scoped temporary conditions; never renewed on read.
MEMORY_TRANSIENT_TTL_SECONDS=86400

# rag chunk size; see app/core/config.py for type and validation.
RAG_CHUNK_SIZE=500

# rag chunk overlap; see app/core/config.py for type and validation.
RAG_CHUNK_OVERLAP=80

# rag dedupe similarity threshold; see app/core/config.py for type and validation.
RAG_DEDUPE_SIMILARITY_THRESHOLD=0.92

# rag enable semantic dedupe; see app/core/config.py for type and validation.
RAG_ENABLE_SEMANTIC_DEDUPE=false

# rag parent context chars; see app/core/config.py for type and validation.
RAG_PARENT_CONTEXT_CHARS=800

# rag crawl timeout seconds; see app/core/config.py for type and validation.
RAG_CRAWL_TIMEOUT_SECONDS=15.0

# rag crawl max pages; see app/core/config.py for type and validation.
RAG_CRAWL_MAX_PAGES=40

# rag crawl max depth; see app/core/config.py for type and validation.
RAG_CRAWL_MAX_DEPTH=1

# IANA timezone for relative dates (default Asia/Shanghai).
APP_TIMEZONE=Asia/Shanghai

# redis url; see app/core/config.py for type and validation.
REDIS_URL=redis://127.0.0.1:6379/0

# redis enabled; see app/core/config.py for type and validation.
REDIS_ENABLED=true

# memory short window messages; see app/core/config.py for type and validation.
MEMORY_SHORT_WINDOW_MESSAGES=12

# memory short ttl seconds; see app/core/config.py for type and validation.
MEMORY_SHORT_TTL_SECONDS=604800

# Autonomous memory background switch; on by default (2026-10-02). Explicit
# false wins. Startup probes the durable budget tables read-only and keeps the
# background worker off with an observable health reason if they are missing;
# tables are normally created by startup DDL. See docs/memory-background-control.md.
MEMORY_BACKGROUND_ENABLED=true

# memory summary enabled; see app/core/config.py for type and validation.
MEMORY_SUMMARY_ENABLED=true

# memory summary timeout seconds; see app/core/config.py for type and validation.
MEMORY_SUMMARY_TIMEOUT_SECONDS=30.0

# workout parser enabled; see app/core/config.py for type and validation.
WORKOUT_PARSER_ENABLED=true

# input parser enabled; see app/core/config.py for type and validation.
INPUT_PARSER_ENABLED=true

# chat history max messages; see app/core/config.py for type and validation.
CHAT_HISTORY_MAX_MESSAGES=200

# chat history ttl seconds; see app/core/config.py for type and validation.
CHAT_HISTORY_TTL_SECONDS=2592000

# langsmith tracing; see app/core/config.py for type and validation.
LANGSMITH_TRACING=false

# langsmith api key; see app/core/config.py for type and validation.
LANGSMITH_API_KEY=

# langsmith project; see app/core/config.py for type and validation.
LANGSMITH_PROJECT=fitness-assistant

# langsmith endpoint; see app/core/config.py for type and validation.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Run structured Planner comparisons alongside the rule path; diagnostic only, default off.
PLANNER_SHADOW_ENABLED=false

# ReAct is the default path: the frontend sends react_readonly for chat and
# react_write for explicit records. Set both false for offline/no-credential
# environments to fall back to the legacy rule path.
REACT_READONLY_ENABLED=true
REACT_WRITE_ENABLED=true
# Mode used when a client omits the `mode` field. auto picks react_write for a
# validated write (when gates are ready), react_readonly for pure reads, legacy
# otherwise. Set legacy to restore the old default.
CHAT_DEFAULT_MODE=auto

# Durable physical-model budgets; no currency guarantee.
MODEL_HTTP_MAX_ATTEMPTS=2
MODEL_STAGE_MAX_CALLS=2
MODEL_REQUEST_MAX_CALLS=12
MODEL_REQUEST_MAX_TOKENS=64000
MODEL_REQUEST_DEADLINE_SECONDS=120
# One ceiling for every new business task, regardless of task type:
# chat + embedding + rerank + retries + corrections are all counted.
MODEL_TASK_MAX_CALLS=12
MODEL_TASK_MAX_TOKENS=64000
# Deprecated compatibility only; ignored by new per-task budgets.
MODEL_TASK_STANDARD_MAX_CALLS=8
MODEL_TASK_PLAN_MAX_CALLS=12
MODEL_PREPARE_MAX_CALLS=8
MODEL_DAILY_MAX_CALLS=200
MODEL_DAILY_MAX_TOKENS=1000000
MODEL_BACKGROUND_DAILY_MAX_CALLS=20
MODEL_BACKGROUND_MAX_CALLS=5
MODEL_BACKGROUND_MAX_TOKENS=24000
MODEL_CLI_MAX_CALLS=50
MODEL_CLI_MAX_TOKENS=500000
MODEL_CLI_DEADLINE_SECONDS=1800
MODEL_RETRY_BACKOFF_SECONDS=1
MEMORY_OUTBOX_MAX_ATTEMPTS=3
MEMORY_OUTBOX_TTL_SECONDS=1800
