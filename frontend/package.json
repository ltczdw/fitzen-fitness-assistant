{
  "name": "fitness-assistant-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "vue-tsc -b",
    "build:isolated": "node tests/isolated-build.mjs",
    "dev": "vite",
    "tokens:export": "node scripts/export-tokens.mjs",
    "design:check": "node scripts/check-design-system.mjs",
    "design:test": "node --test tests/design-system.test.mjs tests/delete-button.test.mjs",
    "prebuild": "npm run design:check",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "pinia": "4.0.3",
    "vite": "8.2.2",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "autoprefixer": "10.6.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11"
  }
}
